SB_TABLE=second_brain

# Hygiene defaults
SB_HYGIENE_MAX_AGE_DAYS=90
SB_HYGIENE_REPORT_FORMAT=text
SB_HYGIENE_EXPIRE_BATCH_SIZE=100
